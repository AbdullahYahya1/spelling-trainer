{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_HERE_AT_LEAST_32_CHARS",
    "Issuer": "SpellingTrainer",
    "Audience": "SpellingTrainerUsers",
    "ExpirationMinutes": 43200
  },
  "Authentica": {
    "ApiUrl": "https://api.authentica.sa",
    "AuthToken": "YOUR_AUTHENTICA_TOKEN_HERE"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

